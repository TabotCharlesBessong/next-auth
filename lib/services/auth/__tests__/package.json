{
  "name": "@next-auth/services-tests",
  "version": "1.0.0",
  "description": "Test suite for Next.js authentication services",
  "private": true,
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:unit": "jest --testPathPattern='\\.(test|spec)\\.(ts|js)$' --testPathIgnorePatterns='integration'",
    "test:integration": "jest --testPathPattern='integration'",
    "test:auth": "jest AuthService",
    "test:token": "jest TokenService",
    "test:email": "jest EmailService",
    "test:hash": "jest HashService",
    "test:oauth": "jest OAuthService",
    "test:security": "jest SecurityService",
    "test:all": "jest --verbose",
    "lint": "eslint **/*.ts --fix",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.9.0",
    "@types/nodemailer": "^6.4.14",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "jest-watch-typeahead": "^2.2.2",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "nextjs",
    "authentication",
    "auth",
    "jwt",
    "oauth",
    "security",
    "testing",
    "jest",
    "typescript"
  ],
  "author": "Next.js Auth Services",
  "license": "MIT"
}